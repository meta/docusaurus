{
  "name": "@docusaurus/plugin-content-blog",
  "version": "4.0.0",
  "description": "Blog plugin for Docusaurus.",
  "main": "lib/index.js",
  "types": "src/plugin-content-blog.d.ts",
  "exports": {
    "./lib/*": "./lib/*",
    "./src/*": "./src/*",
    "./client": {
      "type": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    ".": {
      "types": "./src/plugin-content-blog.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "test:generate-build-snap": "pnpm docusaurus build src/__tests__/__fixtures__/website --out-dir build-snap && pnpm rimraf src/__tests__/__fixtures__/website/.docusaurus && pnpm rimraf src/__tests__/__fixtures__/website/build-snap/assets && git add src/__tests__/__fixtures__/website/build-snap"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-plugin-content-blog"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/fs": "workspace:*",
    "@docusaurus/glob": "workspace:*",
    "@docusaurus/logger": "workspace:*",
    "@docusaurus/mdx-loader": "workspace:*",
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/theme-common": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-common": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "cheerio": "catalog:",
    "combine-promises": "catalog:",
    "feed": "catalog:",
    "lodash": "catalog:",
    "schema-dts": "catalog:",
    "srcset": "catalog:",
    "tslib": "catalog:",
    "unist-util-visit": "catalog:",
    "utility-types": "catalog:",
    "webpack": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  },
  "devDependencies": {
    "@mdx-js/mdx": "catalog:",
    "@total-typescript/shoehorn": "catalog:dev",
    "@types/mdast": "catalog:",
    "remark-gfm": "catalog:",
    "to-vfile": "catalog:dev",
    "tree-node-cli": "catalog:dev",
    "unified": "catalog:"
  }
}
