exports[`inlineScripts > getAnnouncementBarInlineScript > generates inline javascript with announcement bar id 1`] = `
"(function() {
  function isDismissed() {
    try {
      if (localStorage.getItem('docusaurus.announcement.id') !== "announcement-1") {
        return false;
      }
      return localStorage.getItem('docusaurus.announcement.dismiss') === 'true';
    } catch (err) {}
    return false;
  }
  document.documentElement.setAttribute('data-announcement-bar-initially-dismissed', isDismissed());
})();"
`;

