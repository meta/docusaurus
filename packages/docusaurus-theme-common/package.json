{
  "name": "@docusaurus/theme-common",
  "version": "4.0.0",
  "description": "Common code for Docusaurus themes.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": [
    "lib/components/Details/*",
    "*.css"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./internal": "./lib/internal.js",
    "./Details": "./lib/components/Details/index.js"
  },
  "scripts": {
    "build": "tsc && copy-untyped-files",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --watch",
    "copy:watch": "copy-untyped-files --watch",
    "removeThemeInternalReexport": "node removeThemeInternalReexport.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-theme-common"
  },
  "license": "MIT",
  "dependencies": {
    "@docusaurus/mdx-loader": "workspace:*",
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-common": "workspace:*",
    "@types/history": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-router-config": "catalog:",
    "clsx": "catalog:",
    "parse-numeric-range": "catalog:",
    "prism-react-renderer": "catalog:",
    "tslib": "catalog:",
    "utility-types": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@total-typescript/shoehorn": "catalog:dev",
    "@types/react-router-dom": "catalog:",
    "lodash": "catalog:",
    "react-router-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
