// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`transformImage plugin > does not choke on invalid image 1`] = `
"<img alt="invalid image" src={require("!./../static/invalid.png?docusaurus-asset=image")} />
"
`;

exports[`transformImage plugin > pathname protocol 1`] = `
"![img](/img/unchecked.png)
"
`;

exports[`transformImage plugin > transform md images to <img /> 1`] = `
"![img](https://example.com/img.png)

<img src={require("!./static/img.png?docusaurus-asset=image")} width="200" height="200" />

<img alt="img" src={require("!./static/img.png?docusaurus-asset=image")} width="200" height="200" />

in paragraph <img alt="img" src={require("!./static/img.png?docusaurus-asset=image")} width="200" height="200" />

<img alt="img from second static folder" src={require("!./static2/img2.png?docusaurus-asset=image")} width="256" height="82" />

<img alt="img from second static folder" src={require("!./static2/img2.png?docusaurus-asset=image")} width="256" height="82" />

<img alt="img with URL encoded chars" src={require("!./static2/img2 copy.png?docusaurus-asset=image")} width="256" height="82" />

<img alt="img" src={require("!./static/img.png?docusaurus-asset=image")} title="Title" width="200" height="200" /> <img alt="img" src={require("!./static/img.png?docusaurus-asset=image")} width="200" height="200" />

!/[img with "quotes"]/(./static/img.png ''Quoted' title')

<img alt="site alias" src={require("!./static/img.png?docusaurus-asset=image")} width="200" height="200" />

<img alt="img with hash" src={require("!./static/img.png?docusaurus-asset=image") + '#light'} width="200" height="200" /> <img alt="img with hash" src={require("!./static/img.png?docusaurus-asset=image") + '#dark'} width="200" height="200" />

<img alt="img with query" src={require("!./static/img.png?w=10&docusaurus-asset=image")} width="200" height="200" /> <img alt="img with query" src={require("!./static/img.png?w=10&h=10&docusaurus-asset=image")} width="200" height="200" />

<img alt="img with both" src={require("!./static/img.png?w=10&h=10&docusaurus-asset=image") + '#light'} width="200" height="200" />

