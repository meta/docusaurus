{
  "name": "@docusaurus/infima",
  "version": "4.0.0",
  "description": "Infima CSS framework, used by the Docusaurus classic theme.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./infima.css": "./dist/infima.css",
    "./infima-rtl.css": "./dist/infima-rtl.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meta/docusaurus.git",
    "directory": "packages/docusaurus-infima"
  },
  "license": "MIT",
  "devDependencies": {
    "postcss": "catalog:",
    "postcss-color-mod-function": "catalog:dev",
    "postcss-combine-duplicated-selectors": "catalog:dev",
    "postcss-each": "catalog:dev",
    "postcss-for": "catalog:dev",
    "postcss-import": "catalog:dev",
    "postcss-mixins": "catalog:dev",
    "postcss-nested": "catalog:dev",
    "postcss-nested-ancestors": "catalog:dev",
    "postcss-preset-env-v7": "catalog:dev",
    "postcss-sort-media-queries": "catalog:dev",
    "rtlcss": "catalog:"
  },
  "engines": {
    "node": ">=26.13"
  }
}
