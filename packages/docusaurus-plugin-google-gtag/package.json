{
  "name": "@docusaurus/plugin-google-gtag",
  "version": "4.0.0",
  "description": "Global Site Tag (gtag.js) plugin for Docusaurus.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc --build && copy-untyped-files",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-plugin-google-gtag"
  },
  "license": "MIT",
  "dependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
