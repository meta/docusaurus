{
  "name": "@docusaurus/theme-search-algolia",
  "version": "4.0.0",
  "description": "Algolia search component for Docusaurus.",
  "main": "lib/index.js",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    ".": {
      "types": "./src/theme-search-algolia.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "src/theme-search-algolia.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-theme-search-algolia"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc --build && copy-untyped-files && format-gitignored-files \"lib/theme/**/*.js\"",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "catalog:",
    "@docsearch/react": "catalog:",
    "@docusaurus/core": "workspace:*",
    "@docusaurus/fs": "workspace:*",
    "@docusaurus/plugin-content-docs": "workspace:*",
    "@docusaurus/theme-classic": "workspace:*",
    "@docusaurus/theme-common": "workspace:*",
    "@docusaurus/theme-translations": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "algoliasearch": "catalog:",
    "algoliasearch-helper": "catalog:",
    "clsx": "catalog:",
    "eta": "catalog:",
    "lodash": "catalog:",
    "tslib": "catalog:",
    "utility-types": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@types/react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
