{
  "name": "@docusaurus/plugin-debug",
  "version": "4.0.0",
  "description": "Debug plugin for Docusaurus.",
  "main": "lib/index.js",
  "types": "src/plugin-debug.d.ts",
  "scripts": {
    "build": "tsc --build && copy-untyped-files && format-gitignored-files \"lib/theme/**/*.js\"",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-plugin-debug"
  },
  "license": "MIT",
  "dependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "react-json-view-lite": "catalog:",
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
