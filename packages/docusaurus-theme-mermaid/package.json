{
  "name": "@docusaurus/theme-mermaid",
  "version": "4.0.0",
  "description": "Mermaid components for Docusaurus.",
  "main": "lib/index.js",
  "types": "src/theme-mermaid.d.ts",
  "sideEffects": false,
  "exports": {
    "./lib/*": "./lib/*",
    "./src/*": "./src/*",
    "./client": {
      "type": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    ".": {
      "types": "./src/theme-mermaid.d.ts",
      "default": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-theme-mermaid"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc --build && copy-untyped-files && format-gitignored-files \"lib/theme/**/*.js\"",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "dependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/theme-common": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "mermaid": "catalog:",
    "tslib": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
