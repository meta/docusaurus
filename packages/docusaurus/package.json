{
  "name": "@docusaurus/core",
  "description": "Easy to Maintain Open Source Documentation Websites",
  "version": "4.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "static site generator",
    "webpack",
    "documentation",
    "websites",
    "open source",
    "docusaurus"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus"
  },
  "bin": {
    "docusaurus": "bin/docusaurus.mjs"
  },
  "scripts": {
    "build": "tsc --build && copy-untyped-files",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "bugs": {
    "url": "https://github.com/facebook/docusaurus/issues"
  },
  "dependencies": {
    "@docusaurus/babel": "workspace:*",
    "@docusaurus/bundler": "workspace:*",
    "@docusaurus/fs": "workspace:*",
    "@docusaurus/glob": "workspace:*",
    "@docusaurus/logger": "workspace:*",
    "@docusaurus/mdx-loader": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-common": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "@rspack/core": "catalog:",
    "@rspack/dev-server": "catalog:",
    "boxen": "catalog:",
    "cli-table3": "catalog:",
    "combine-promises": "catalog:",
    "commander": "catalog:",
    "detect-port": "catalog:",
    "escape-html": "catalog:",
    "eta": "catalog:",
    "execa": "catalog:",
    "html-tags": "catalog:",
    "leven": "catalog:",
    "lodash": "catalog:",
    "open": "catalog:",
    "p-map": "catalog:",
    "prompts": "catalog:",
    "react-helmet-async": "catalog:",
    "react-loadable": "catalog:",
    "react-loadable-ssr-addon-v5-slorber": "catalog:",
    "react-router": "catalog:",
    "react-router-config": "catalog:",
    "react-router-dom": "catalog:",
    "semver": "catalog:",
    "serve-handler": "catalog:",
    "tinypool": "catalog:",
    "tslib": "catalog:",
    "update-notifier": "catalog:",
    "webpack": "catalog:",
    "webpack-dev-server": "catalog:",
    "webpack-merge": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@total-typescript/shoehorn": "catalog:dev",
    "@types/escape-html": "catalog:dev",
    "@types/history": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-router-config": "catalog:",
    "@types/react-router-dom": "catalog:",
    "@types/serve-handler": "catalog:dev",
    "@types/update-notifier": "catalog:dev",
    "@types/webpack-env": "catalog:dev",
    "tree-node-cli": "catalog:dev",
    "utility-types": "catalog:"
  },
  "peerDependencies": {
    "@mdx-js/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
