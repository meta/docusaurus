{
  "name": "@docusaurus/plugin-content-docs",
  "version": "4.0.0",
  "description": "Docs plugin for Docusaurus.",
  "main": "lib/index.js",
  "sideEffects": false,
  "exports": {
    "./lib/*": "./lib/*",
    "./src/*": "./src/*",
    "./client": {
      "type": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./server": {
      "type": "./lib/server-export.d.ts",
      "default": "./lib/server-export.js"
    },
    ".": {
      "types": "./src/plugin-content-docs.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "src/plugin-content-docs.d.ts",
  "scripts": {
    "build": "tsc --build",
    "watch": "tsc --build --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-plugin-content-docs"
  },
  "license": "MIT",
  "dependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/fs": "workspace:*",
    "@docusaurus/glob": "workspace:*",
    "@docusaurus/logger": "workspace:*",
    "@docusaurus/mdx-loader": "workspace:*",
    "@docusaurus/module-type-aliases": "workspace:*",
    "@docusaurus/theme-common": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-common": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "@types/react-router-config": "catalog:",
    "combine-promises": "catalog:",
    "js-yaml": "catalog:",
    "lodash": "catalog:",
    "schema-dts": "catalog:",
    "tslib": "catalog:",
    "utility-types": "catalog:",
    "webpack": "catalog:"
  },
  "devDependencies": {
    "@total-typescript/shoehorn": "catalog:dev",
    "@types/picomatch": "catalog:dev",
    "@types/react-router-dom": "catalog:",
    "commander": "catalog:",
    "picomatch": "catalog:dev",
    "react-router-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.21"
  }
}
