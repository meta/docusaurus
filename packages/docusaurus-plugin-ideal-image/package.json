{
  "name": "@docusaurus/plugin-ideal-image",
  "version": "4.0.0",
  "description": "Docusaurus Plugin to generate an almost ideal image (responsive, lazy-loading, and low quality placeholder).",
  "main": "lib/index.js",
  "types": "src/plugin-ideal-image.d.ts",
  "scripts": {
    "build": "tsc --build && copy-untyped-files && format-gitignored-files \"lib/theme/**/*.js\"",
    "watch": "run-p -c copy:watch build:watch",
    "build:watch": "tsc --build --watch",
    "copy:watch": "copy-untyped-files --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/docusaurus.git",
    "directory": "packages/docusaurus-plugin-ideal-image"
  },
  "license": "MIT",
  "dependencies": {
    "@docusaurus/core": "workspace:*",
    "@docusaurus/lqip-loader": "workspace:*",
    "@docusaurus/responsive-loader": "catalog:",
    "@docusaurus/theme-translations": "workspace:*",
    "@docusaurus/types": "workspace:*",
    "@docusaurus/utils": "workspace:*",
    "@docusaurus/utils-validation": "workspace:*",
    "sharp": "catalog:",
    "tslib": "catalog:",
    "webpack": "catalog:"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "workspace:*"
  },
  "peerDependencies": {
    "jimp": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "jimp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.21"
  }
}
